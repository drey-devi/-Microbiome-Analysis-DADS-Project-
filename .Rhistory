# Load required packages
library(phyloseq)
library(msa)
library(phangorn)
library(Biostrings)
library(ape)
# Extract DNA sequences (refseq must be available in arg1)
ref_seq <- refseq(arg1)
# Remove any empty sequences
ref_seq <- ref_seq[width(ref_seq) > 0]
library(Biostrings)
# Save your ref_seq (a DNAStringSet) to a FASTA file
writeXStringSet(ref_seq, filepath = "ref_sequences.fasta")
# Align the reference sequences using ClustalOmega
#alignment <- msa(ref_seq, method = "ClustalOmega")
aligned_seqs <- readDNAStringSet("aligned_ref_sequences.fasta")
# Convert to phangorn format
phang_align <- msaConvert(aligned_seqs, type = "phangorn::phyDat")
library(phangorn)
# Convert aligned sequences to phyDat object
phang_align <- phyDat(as.matrix(aligned_seqs), type = "DNA")
# Distance matrix and NJ tree
dm <- dist.ml(phang_align)
tree_NJ <- NJ(dm)
# Fit and optimize tree
fit <- pml(tree_NJ, data = phang_align)
fitGTR <- optim.pml(fit, model = "GTR", optInv = TRUE, optGamma = TRUE,
rearrangement = "stochastic", control = pml.control(trace = 0))
# Midpoint root
rooted_tree <- midpoint(fitGTR$tree)
# Merge with phyloseq object
arg1_tree <- merge_phyloseq(arg1, rooted_tree)
saveRDS(arg1_tree, "phyloseq_with_tree.rds")
arg1_tree
saveRDS(arg1_tree, "phyloseq_with_tree.rds")
pwd()
cwd()
ls
ls()
tree <- phy_tree(arg1)
arg1
arg1_tree
tree <- phy_tree(arg1_tree)
tree
# Load the ggtree package
library(ggtree)
library(phyloseq)
# Extract the tree from the phyloseq object
tree <- phy_tree(arg1_tree)
# Plot using ggtree
ggtree(tree) +
geom_tiplab(size = 2) +
theme_tree2() +
ggtitle("Phylogenetic Tree of 16S Sequences")
# Load the ggtree package
library(ggtree)
library(phyloseq)
# Extract the tree from the phyloseq object
tree <- phy_tree(arg1_tree)
# Plot using ggtree
ggtree(tree, layout = "circular") +
geom_tiplab(size = 1) +
ggtitle("Circular Phylogenetic Tree of 16S Sequences")
write.tree(tree, file = "tree_for_iTOL.nwk")
